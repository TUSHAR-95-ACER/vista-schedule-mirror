{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://gdrzwezxaofpucbwkrcr.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "tg-master-journal-mcp",
      "version": "0.2.0",
      "title": "TG Master Journal"
    },
    "tools": [
      {
        "name": "get_dashboard_summary",
        "title": "Get dashboard summary",
        "description": "High-level snapshot of the signed-in user's journal: all-time and last-30-day performance, top sessions and pairs, account balances, and the most recent trades.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_performance_metrics",
        "title": "Get performance metrics",
        "description": "Compute the signed-in user's performance metrics: win rate, net P/L, profit factor, expectancy, average win/loss and average R. Optionally scoped to a date range, and optionally broken down by session, asset, setup or grade.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "description": "Start date (inclusive) in YYYY-MM-DD."
            },
            "to": {
              "type": "string",
              "description": "End date (inclusive) in YYYY-MM-DD."
            },
            "days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3650,
              "description": "Alternative to from/to: last N days."
            },
            "group_by": {
              "type": "string",
              "description": "Optional breakdown dimension: session, asset, setup or grade."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_equity_curve",
        "title": "Get equity curve",
        "description": "Return the signed-in user's cumulative P/L curve over time, with peak equity and max drawdown. Optionally scoped to a date range and offset by a starting balance.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "description": "Start date (inclusive) in YYYY-MM-DD."
            },
            "to": {
              "type": "string",
              "description": "End date (inclusive) in YYYY-MM-DD."
            },
            "starting_balance": {
              "type": "number",
              "description": "Balance the curve starts from. Default 0."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_period_stats",
        "title": "Get monthly or weekly statistics",
        "description": "Break the signed-in user's performance down by month or by week (net P/L, win rate, profit factor, trade count per period). Useful for month-over-month comparison and weekly reporting.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "period": {
              "type": "string",
              "description": "Bucket size: 'month' (default) or 'week'."
            },
            "from": {
              "type": "string",
              "description": "Start date (inclusive) in YYYY-MM-DD."
            },
            "to": {
              "type": "string",
              "description": "End date (inclusive) in YYYY-MM-DD."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60,
              "default": 12,
              "description": "Max periods returned, most recent first. Default 12."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_trade_stats",
        "title": "Get trade performance stats",
        "description": "Compute aggregate performance stats (trade count, win rate, total P/L, average R) across the signed-in user's trades, optionally filtered to the last N days.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3650,
              "description": "Only include trades from the last N days. Omit for all-time stats."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_trades",
        "title": "List and filter trades",
        "description": "List the signed-in user's trades with optional filters (pair/asset, session, setup, grade, result, direction, market, date range) plus sorting and pagination. Returns core trade fields.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "asset": {
              "type": "string",
              "description": "Filter by pair/asset symbol, e.g. XAUUSD."
            },
            "session": {
              "type": "string",
              "description": "Filter by session, e.g. London, New York."
            },
            "setup": {
              "type": "string",
              "description": "Filter by setup name."
            },
            "grade": {
              "type": "string",
              "description": "Filter by trade grade: A+, A, B, C."
            },
            "result": {
              "type": "string",
              "description": "Filter by result: Win, Loss, Breakeven, Untriggered Setup, Cancelled."
            },
            "direction": {
              "type": "string",
              "description": "Filter by direction: Long or Short."
            },
            "market": {
              "type": "string",
              "description": "Filter by market, e.g. Forex, Crypto, Indices."
            },
            "from": {
              "type": "string",
              "description": "Start date (inclusive) in YYYY-MM-DD."
            },
            "to": {
              "type": "string",
              "description": "End date (inclusive) in YYYY-MM-DD."
            },
            "min_rr": {
              "type": "number",
              "description": "Only trades whose actual RR is >= this value."
            },
            "sort": {
              "type": "string",
              "description": "Sort field: date, profit_loss, actual_rr, planned_rr. Default date."
            },
            "order": {
              "type": "string",
              "description": "Sort order: asc or desc. Default desc."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50,
              "description": "Page size (1-200). Default 50."
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "description": "Rows to skip for pagination. Default 0."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "search_trades",
        "title": "Search trades by text",
        "description": "Free-text search across the signed-in user's trades. Matches notes, setup, asset, session and grade. Use for questions like 'losing XAUUSD trades' or 'trades where I mention FOMO'.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Text to search for in notes, setup, asset or session."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25,
              "description": "Max rows to return. Default 25."
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "description": "Rows to skip for pagination."
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_trade",
        "title": "Get a trade by ID",
        "description": "Fetch one full trade record (including notes, confluences, psychology, management and analysis) by its ID, scoped to the signed-in user.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "The trade ID."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_recent_trades",
        "title": "List recent trades",
        "description": "List the signed-in user's most recent trades from TG Master Journal, ordered by date. Returns core fields (asset, direction, session, setup, grade, planned/actual RR, P/L, result).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "description": "Max trades to return (1-100). Default 20."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_daily_plan",
        "title": "Get daily trading plan",
        "description": "Fetch the signed-in user's daily trading plan for a specific date (YYYY-MM-DD). Defaults to today when no date is supplied.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Plan date in YYYY-MM-DD. Defaults to today."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_daily_plans",
        "title": "List daily plans",
        "description": "List the signed-in user's daily plans with bias, session focus, risk limits, review status and pair count. Use `get_daily_plan` for the full detail of one day.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "description": "Start date (inclusive) in YYYY-MM-DD."
            },
            "to": {
              "type": "string",
              "description": "End date (inclusive) in YYYY-MM-DD."
            },
            "reviewed": {
              "type": "boolean",
              "description": "Filter by whether the plan has been reviewed."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "description": "Page size. Default 20."
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "description": "Rows to skip for pagination."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_weekly_plan",
        "title": "Get weekly plan and review",
        "description": "Fetch the signed-in user's weekly plan (bias, markets, setups, key levels, risk, goals, per-pair analyses, news and review notes) for a given week start date. Defaults to the most recent week.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "week_start": {
              "type": "string",
              "description": "Week start date in YYYY-MM-DD. Omit for the latest week."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_checklist",
        "title": "Get trading checklist, progress and streak",
        "description": "Fetch the signed-in user's daily trading checklist for a date (defaults to today) with per-section progress, plus recent history and completion streaks.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "description": "Checklist date in YYYY-MM-DD. Defaults to today."
            },
            "history_days": {
              "type": "integer",
              "minimum": 0,
              "maximum": 365,
              "default": 30,
              "description": "How many days of history to include. Default 30, 0 to skip."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "search_notebook",
        "title": "Search and list notebook entries",
        "description": "List or free-text search the signed-in user's notebook/journal entries (pair, category, bias, journal text). Use for questions like 'notes about liquidity' or 'entries mentioning FOMO'.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Text to match in journal text, pair, category or bias. Omit to list all."
            },
            "pair": {
              "type": "string",
              "description": "Filter by pair, e.g. XAUUSD."
            },
            "category": {
              "type": "string",
              "description": "Filter by notebook category."
            },
            "from": {
              "type": "string",
              "description": "Start date (inclusive) in YYYY-MM-DD."
            },
            "to": {
              "type": "string",
              "description": "End date (inclusive) in YYYY-MM-DD."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25,
              "description": "Page size. Default 25."
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "description": "Rows to skip for pagination."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
